{
  "name": "playwrighttesting",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "regression": "npx playwright test",
    "uitests": "npx playwright test --grep @web",
    "apitests": "npx playwright test --grep @api",
    "smoke": "npx playwright test --grep @smoke",
    "safaribrowser": "npx playwright test --config playwright.config1.js --project=safari",
    "AllureUiTests": "npx playwright test --grep @web --reporter=line,allure-playwright",
    "CucumberRegression":"npx cucumber-js --tags '@Regression' --retry 1 --exit --format html:cucumber-report1.html",
  
    "CucumberReg": "npx cucumber-js --tags \"@Regression\" --retry 1 --exit --format html:cucumber-report1.html",

    "CucumberValidations":"npx cucumber-js --tags '@Validations' --retry 1 --exit --format html:cucumber-report1.html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.5",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "exceljs": "^3.4.0"
  }
}
